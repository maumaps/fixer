[Unit]
Description=Maumap Fixer evidence daemon
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/fixerd run --config /etc/fixer/fixer.toml
Restart=on-failure
RestartSec=10
WorkingDirectory=/var/lib/fixer
StateDirectory=fixer
LogsDirectory=fixer
NoNewPrivileges=yes
# read-only, not yes: the patch engine and the repositories Fixer builds
# workspaces from live in a user home on a normal developer machine. With
# ProtectHome=yes the daemon cannot even see its own `codex` binary, so every
# worker poll reported "Codex is not installed on this host".
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
